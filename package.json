        "is-empty-dir": "^2.0.0",
        "oxfmt": "^0.54.0",
        "oxlint": "^1.69.0",
        "oxlint-tsgolint": "^0.23.0",
        "stylelint": "^17.13.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^6.0.3",
        "unplugin-dts": "^1.0.2",
        "vite": "^8.0.16",
        "vite-plugin-html-minifier": "^1.0.5",
        "vite-plugin-static-copy": "^4.1.1",
        "vite-plugin-svgr": "^5.2.0"
