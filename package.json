{
    "type": "module",
    "scripts": {
        "dev": "cross-env env=ext vite build --mode development",
        "prod": "cross-env env=ext vite build --mode production",
        "dev_app": "cross-env env=app vite build --mode development",
        "prod_app": "cross-env env=app vite build --mode production",
        "fix": "oxfmt && oxlint --ignore-pattern **/*.scss --fix && tsc --noEmit",
