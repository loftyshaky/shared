{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist",
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "typeRoots": ["node_modules/@types"],
        "types": ["node"],
        "paths": {
            "build/*": ["./build/*"],
            "custom": ["./src/ts/custom.d.ts"],
            "shared_clean/*": ["./src/ts/shared_clean/*"],
            "shared/*": ["./src/ts/shared/*"],
            "error_modules/*": ["./src/ts/error_modules/*"],
            "error_modules_clean/*": ["./src/ts/error_modules_clean/*"],
            "inputs/*": ["./src/ts/inputs/*"],
            "settings/*": ["./src/ts/settings/*"],
            "announcement/*": ["./src/ts/announcement/*"],
            "dependencies/*": ["./src/ts/dependencies/*"]
        }
    },
    "include": ["src/ts/**/*", "build/**/*"]
}
